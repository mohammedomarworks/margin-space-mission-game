[node name="Sec1Title" type="Label" parent="ScrollContainer/ContentVBox/BodyPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.22, 0.74, 0.96, 1)
theme_override_font_sizes/font_size = 15
text = "1. SCIENTIFIC OBJECTIVE & THE REMOTE SENSING METHOD"

[node name="Sec1Text" type="Label" parent="ScrollContainer/ContentVBox/BodyPanel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.88, 0.94, 1)
theme_override_font_sizes/font_size = 13
text = "How can a satellite detect water ice hidden at the bottom of pitch-black polar craters from 100 kilometers above?
Galactic cosmic rays constantly bombard the lunar regolith, ejecting high-energy secondary neutrons. As these neutrons scatter through the surface materials, they collide with atomic nuclei.

Because hydrogen atoms have virtually identical mass to a neutron, collisions with hydrogen absorb neutron momentum with maximum efficiency—just like two billiard balls colliding. High concentrations of hydrogen absorb and slow down \"epithermal neutrons\". By measuring a sharp drop in epithermal neutron flux with your onboard spectrometer, you map regions with elevated hydrogen content."
autowrap_mode = 2

[node name="CautionCard" type="PanelContainer" parent="ScrollContainer/ContentVBox/BodyPanel/VBox"]
layout_mode = 2
theme_override_styles/panel = SubResource("Style_CautionBox")

[node name="VBox" type="VBoxContainer" parent="ScrollContainer/ContentVBox/BodyPanel/VBox/CautionCard"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="CautionTitle" type="Label" parent="ScrollContainer/ContentVBox/BodyPanel/VBox/CautionCard/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.75, 0.2, 1)
theme_override_font_sizes/font_size = 13
text = "CRITICAL SCIENTIFIC CAUTION (NASA REFERENCE PRINCIPLE)"

[node name="CautionText" type="Label" parent="ScrollContainer/ContentVBox/BodyPanel/VBox/CautionCard/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.9, 0.85, 1)
theme_override_font_sizes/font_size = 12
text = "Hydrogen enhancement detected via neutron flux moderation is a proxy for volatile concentration, but NOT direct proof of pure surface water ice at every location!
Solar wind protons can implant hydrogen in dry silicate grains. High-confidence volatile identification requires combining neutron spectroscopy with radar CPR (Circular Polarization Ratio) or infrared absorption signatures."
autowrap_mode = 2

[node name="RefCard" type="PanelContainer" parent="ScrollContainer/ContentVBox/BodyPanel/VBox"]
layout_mode = 2
theme_override_styles/panel = SubResource("Style_MetricCard")

[node name="VBox" type="VBoxContainer" parent="ScrollContainer/ContentVBox/BodyPanel/VBox/RefCard"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="RefTitle" type="Label" parent="ScrollContainer/ContentVBox/BodyPanel/VBox/RefCard/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.22, 0.74, 0.96, 1)
theme_override_font_sizes/font_size = 12
text = "RELIABLE NASA HERITAGE REFERENCES & SOURCES"

[node name="RefText" type="Label" parent="ScrollContainer/ContentVBox/BodyPanel/VBox/RefCard/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.92, 1)
theme_override_font_sizes/font_size = 11
text = "• Lunar Prospector (1998) Helium-3 Neutron Spectrometer (LP-NS): https://science.nasa.gov/mission/lunar-prospector/
• LRO (2009) Lunar Exploration Neutron Detector (LEND): https://lunar.gsfc.nasa.gov/lend.html
• LRO Miniature Radio Frequency (Mini-RF) Polarimetric Synthetic Aperture Radar: https://www.nasa.gov/mission/mini-rf/"
autowrap_mode = 2

[node name="Sec2Title" type="Label" parent="ScrollContainer/ContentVBox/BodyPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.22, 0.74, 0.96, 1)
theme_override_font_sizes/font_size = 15
text = "2. THE SIX CORE ENGINEERING RESOURCES (THE \"MARGINS\")"

[node name="Sec2Text" type="Label" parent="ScrollContainer/ContentVBox/BodyPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.88, 0.94, 1)
theme_override_font_sizes/font_size = 13
text = "To succeed, you must design a balanced spacecraft across 9 subsystems. Every component choice affects six live resources:

• MASS: Launch vehicles have strict payload caps. Every kilogram saved on structure can be invested into scientific payloads or propellant.
• POWER: Solar panels generate electricity in sunlight, but the spacecraft undergoes periodic lunar orbital eclipses (up to ~48 minutes inside the Moon's shadow cone per 118-minute orbit during edge-on solar geometries). Your battery must sustain life-critical heaters without draining past 70% Depth of Discharge. Note: Orbital eclipse is distinct from permanent lunar surface shadows (PSRs) on crater floors.
• BUDGET: Missions have hard cost caps. Exotic 3D titanium frames or laser optical comms deliver high performance at steep fiscal cost.
• DATA: High-resolution sensors generate gigabits of raw data every day. If your communications system lacks downlink bandwidth, onboard recorders overflow and valuable science is lost.
• COMMS LINK: Lunar distance (~384,400 km) causes massive RF signal attenuation. You need at least +3.0 dB of link margin to close the telemetry stream with Deep Space Network ground stations.
• PROPULSION & ORBIT LIFETIME: The spacecraft must execute its own maneuvers after the rocket delivers it to translunar injection. You can select between two transfer architectures: a Direct Conventional Transfer (3–6 days, citing ~0.94 km/s LOI in a JPL Apollo-11-like reference case; requires high-thrust chemical propulsion) or a Low-Energy Ballistic Transfer (~84 days, citing 669.5 m/s in a specific JPL polar transfer example; compatible with chemical or electric propulsion). In both cases, ~20 m/s for mid-course corrections (MCC) and ~150 m/s for 1-year low-orbit mascon stationkeeping are modeled as separate educational game assumptions. Total ΔV ranges from ~839.5 m/s (Low-Energy) to ~1110 m/s (Direct)."
autowrap_mode = 2

