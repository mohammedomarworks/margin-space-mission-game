layout_mode = 2
theme_override_styles/normal = SubResource("Style_SecondaryBtn_Menu")
theme_override_font_sizes/font_size = 13
text = "HOW TO PLAY"

[node name="FooterDisclaimer" type="Label" parent="CanvasLayer/RootUI"]
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -28.0
offset_bottom = -10.0
grow_horizontal = 2
grow_vertical = 0
theme_override_colors/font_color = Color(0.45, 0.5, 0.58, 0.8)
theme_override_font_sizes/font_size = 10
text = "An independent educational simulation. Not affiliated with or endorsed by NASA or JPL."
horizontal_alignment = 1

[node name="HowToPlayModal" type="PanelContainer" parent="CanvasLayer/RootUI"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -340.0
offset_top = -240.0
offset_right = 340.0
offset_bottom = 240.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("Style_ModalPanel")

[node name="VBox" type="VBoxContainer" parent="CanvasLayer/RootUI/HowToPlayModal"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="ModalHeader" type="HBoxContainer" parent="CanvasLayer/RootUI/HowToPlayModal/VBox"]
layout_mode = 2

[node name="Title" type="Label" parent="CanvasLayer/RootUI/HowToPlayModal/VBox/ModalHeader"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.22, 0.74, 0.96, 1)
theme_override_font_sizes/font_size = 18
text = "HOW TO PLAY MARGIN"

[node name="CloseModalBtn" type="Button" parent="CanvasLayer/RootUI/HowToPlayModal/VBox/ModalHeader"]
custom_minimum_size = Vector2(28, 28)
layout_mode = 2
text = "✕"

[node name="ModalScroll" type="ScrollContainer" parent="CanvasLayer/RootUI/HowToPlayModal/VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="ModalText" type="VBoxContainer" parent="CanvasLayer/RootUI/HowToPlayModal/VBox/ModalScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="P1" type="Label" parent="CanvasLayer/RootUI/HowToPlayModal/VBox/ModalScroll/ModalText"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.93, 0.98, 1)
theme_override_font_sizes/font_size = 12
text = "1. THE ENGINEERING CHALLENGE
In space missions, there are no \"perfect\" spacecraft. Every component choice involves rigorous physical trade-offs. You are given a scientific goal, a launch mass limit, and a strict budget."
autowrap_mode = 2

[node name="P2" type="Label" parent="CanvasLayer/RootUI/HowToPlayModal/VBox/ModalScroll/ModalText"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.93, 0.98, 1)
theme_override_font_sizes/font_size = 12
text = "2. NINE SUBSYSTEMS
Configure your vehicle across Structure, Power, Battery, Propulsion, Comms, Computer, ADCS, Thermal, and Scientific Instruments. You can rotate and zoom around the 3D spacecraft to inspect individual modules."
autowrap_mode = 2

[node name="P3" type="Label" parent="CanvasLayer/RootUI/HowToPlayModal/VBox/ModalScroll/ModalText"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.93, 0.98, 1)
theme_override_font_sizes/font_size = 12
text = "3. SIX LIVE MARGINS
Keep all six gauges positive:
• Mass (must stay below 380 kg)
• Power (sunlight surplus + battery eclipse DoD <= 70%)
• Budget (must stay below $180.0M)
• Data (downlink throughput must exceed sensor generation)
• Comms (RF link margin >= +3.0 dB)
• Orbit Lifetime (propulsion ΔV >= 150 m/s for 1 year)"
autowrap_mode = 2

[node name="P4" type="Label" parent="CanvasLayer/RootUI/HowToPlayModal/VBox/ModalScroll/ModalText"]
layout_mode = 2
theme_override_colors/font_color = Color(0.22, 0.74, 0.96, 1)
theme_override_font_sizes/font_size = 12
text = "4. SIGNATURE FEATURE: TRADE-OFF ECHO
Every time you swap a module, the Trade-Off Echo analyzes the exact impact on your margins and presents real-world aerospace insights."
autowrap_mode = 2

[connection signal="pressed" from="CanvasLayer/RootUI/BrandLayout/MenuButtons/LunarFrontierBtn" to="." method="_on_lunar_frontier_pressed"]
[connection signal="pressed" from="CanvasLayer/RootUI/BrandLayout/MenuButtons/StartMissionBtn" to="." method="_on_start_mission_pressed"]
[connection signal="pressed" from="CanvasLayer/RootUI/BrandLayout/MenuButtons/MissionBriefingBtn" to="." method="_on_mission_briefing_pressed"]
[connection signal="pressed" from="CanvasLayer/RootUI/BrandLayout/MenuButtons/WorkshopDirectBtn" to="." method="_on_jump_to_workshop_pressed"]
[connection signal="pressed" from="CanvasLayer/RootUI/BrandLayout/MenuButtons/HowToPlayBtn" to="." method="_on_how_to_play_pressed"]
[connection signal="pressed" from="CanvasLayer/RootUI/HowToPlayModal/VBox/ModalHeader/CloseModalBtn" to="." method="_on_close_modal_pressed"]
