theme_override_constants/separation = 12

[node name="P1" type="Label" parent="CanvasLayer/RootUI/HowToPlayModal/VBox/ModalScroll/ModalText"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.93, 0.98, 1)
theme_override_font_sizes/font_size = 12
text = "1. THE 2038 CRISIS & HELIOS-4
A severe coronal mass ejection (CME) superstorm threatens Earth's power grids, orbital infrastructure, and telecommunications. Four specialists must design, launch, navigate, and commission the HELIOS-4 solar sentinel into a stable halo orbit at Sun-Earth L1 (~1.5 million km sunward)."
autowrap_mode = 2

[node name="P2" type="Label" parent="CanvasLayer/RootUI/HowToPlayModal/VBox/ModalScroll/ModalText"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.93, 0.98, 1)
theme_override_font_sizes/font_size = 12
text = "2. FOUR PASS-AND-PLAY SPECIALIST ROLES
• Propulsion Engineer: Engine thrust, propellant loading, staging separation, and throttle control.
• Structural Architect: Structural mass, dynamic pressure corridor (Max-Q), and aerodynamic static margin.
• Astrogator: Launch azimuth, gravity-turn pitch profile, transfer trajectory, and L1 halo-orbit insertion.
• Systems Officer: Electrical balance, solar arrays, rad-hardened avionics, plasma analyzer, and early-warning telemetry."
autowrap_mode = 2

[node name="P3" type="Label" parent="CanvasLayer/RootUI/HowToPlayModal/VBox/ModalScroll/ModalText"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.93, 0.98, 1)
theme_override_font_sizes/font_size = 12
text = "3. SCIENTIFIC PRINCIPLES & EDUCATIONAL DISCLAIMERS
• Sun-Earth L1 is ~1.5 million km sunward from Earth (approx. 1% of the distance to the Sun), NOT the midpoint.
• Halo orbits around L1 require continuous stationkeeping propellant because libration point collinear orbits are dynamically unstable.
• The spacecraft is an uncrewed robotic probe: no crew oxygen or life-support is needed.
• All rocket staging, dynamic pressure, and costs are calibrated educational game models."
autowrap_mode = 2

[node name="P4" type="Label" parent="CanvasLayer/RootUI/HowToPlayModal/VBox/ModalScroll/ModalText"]
layout_mode = 2
theme_override_colors/font_color = Color(0.22, 0.74, 0.96, 1)
theme_override_font_sizes/font_size = 12
text = "4. NASA DONKI & REAL-WORLD SPACE WEATHER
Real-world DONKI events (CCMC domain) can be viewed as educational benchmarks. In the 2038 campaign, the spacecraft's Faraday Cup and Magnetometer detect incoming solar storms to beam advance warnings (15–60 min notice) back to Earth."
autowrap_mode = 2

[connection signal="pressed" from="CanvasLayer/RootUI/BrandLayout/MenuButtons/ContinueCampaignBtn" to="." method="_on_continue_campaign_pressed"]
