mesh = SubResource("Mesh_Moon_Menu")

[node name="Spacecraft3D" type="Node3D" parent="."]
script = ExtResource("3_craft")

[node name="OrbitCamera" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.2, 3.8)
script = ExtResource("2_cam")
distance = 3.8
pitch = 18.0
auto_rotate = true
auto_rotate_speed = 6.0

[node name="CanvasLayer" type="CanvasLayer" parent="."]

[node name="RootUI" type="Control" parent="CanvasLayer"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="BrandLayout" type="VBoxContainer" parent="CanvasLayer/RootUI"]
layout_mode = 1
anchors_preset = 4
anchor_top = 0.5
anchor_bottom = 0.5
offset_left = 60.0
offset_top = -220.0
offset_right = 460.0
offset_bottom = 220.0
grow_vertical = 2
theme_override_constants/separation = 16

[node name="TitleBox" type="VBoxContainer" parent="CanvasLayer/RootUI/BrandLayout"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="CanvasLayer/RootUI/BrandLayout/TitleBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.22, 0.74, 0.96, 1)
theme_override_font_sizes/font_size = 46
text = "M A R G I N"

[node name="Subtitle" type="Label" parent="CanvasLayer/RootUI/BrandLayout/TitleBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.93, 0.98, 1)
theme_override_font_sizes/font_size = 15
text = "THE SPACE MISSION DESIGN GAME"

[node name="Tagline" type="Label" parent="CanvasLayer/RootUI/BrandLayout/TitleBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.7, 0.8, 1)
theme_override_font_sizes/font_size = 12
text = "Every Gram. Every Watt. Every Decision."

[node name="MissionBanner" type="PanelContainer" parent="CanvasLayer/RootUI/BrandLayout"]
layout_mode = 2
theme_override_styles/panel = SubResource("Style_MenuCard")

[node name="VBox" type="VBoxContainer" parent="CanvasLayer/RootUI/BrandLayout/MissionBanner"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Badge" type="Label" parent="CanvasLayer/RootUI/BrandLayout/MissionBanner/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.22, 0.74, 0.96, 1)
theme_override_font_sizes/font_size = 11
text = "CURRENT CAMPAIGN MISSION:"

[node name="MName" type="Label" parent="CanvasLayer/RootUI/BrandLayout/MissionBanner/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.96, 0.98, 1)
theme_override_font_sizes/font_size = 13
text = "LUNAR SOUTH POLE — VOLATILE MAPPING"

[node name="MDesc" type="Label" parent="CanvasLayer/RootUI/BrandLayout/MissionBanner/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.7, 0.78, 1)
theme_override_font_sizes/font_size = 11
text = "Map epithermal neutron flux depressions and characterize candidate hydrogen-rich regolith deposits in polar craters."
autowrap_mode = 2

[node name="MenuButtons" type="VBoxContainer" parent="CanvasLayer/RootUI/BrandLayout"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="LunarFrontierBtn" type="Button" parent="CanvasLayer/RootUI/BrandLayout/MenuButtons"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_override_styles/normal = SubResource("Style_FrontierBtn_Menu")
theme_override_font_sizes/font_size = 14
text = "► PLAY LUNAR FRONTIER (3D GAME)"

[node name="StartMissionBtn" type="Button" parent="CanvasLayer/RootUI/BrandLayout/MenuButtons"]
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
